
#######################
# 存储配置
#######################
# 数据库URL，支持SQLite和PostgreSQL
DATABASE_URL=sqlite+aiosqlite:///./instance/kd_default.sqlite

# 数据库目录和文件名
DB_DIR=data
DB_NAME=kd_tool.db

#######################
# 日志配置
#######################
# 日志文件路径
LOG_FILE_PATH=logs/kd_tool.log

# 日志级别 (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# 日志文件轮转大小
LOG_ROTATION=10 MB

# 日志保留时间
LOG_RETENTION=7 days

# 是否使用JSON格式序列化日志
LOG_SERIALIZE_JSON=true

# 日志目录和文件名
LOG_DIR=logs
LOG_NAME=kd_tool.log

#######################
# 引擎配置
#######################
# 相似度阈值 (0.0-1.0)
SIMILARITY_THRESHOLD=0.85

# Czkawka可执行文件路径（可选）
# CZKAWKA_PATH=/path/to/czkawka

# 语义模型名称
SEMANTIC_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# 批处理大小
BATCH_SIZE=32

# 缓存配置
CACHE_DIR=cache
CACHE_BASE_DIR=.kd_cache
